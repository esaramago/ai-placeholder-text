{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM"],
    "types": ["@figma/plugin-typings", "node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
